generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")  // 你的 6543 端口链接
  directUrl = env("DIRECT_URL")   // 你的 5432 端口链接 (新增这一行)
}

model User {
  id                String        @id @default(cuid())
  workId            String        @unique
  name              String?
  password          String
  isDefaultPassword Boolean       @default(true)
  assignedAreas     String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  dailyReports      DailyReport[]
  issues            Issue[]
  tasks             Task[]
  roles             Role[]        @relation("RoleToUser")
  aiSummaries      AISummary[]
  weeklyReports    WeeklyReport[]
}

model Role {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  users       User[]  @relation("RoleToUser")
}

model Question {
  id        String  @id @default(cuid())
  order     Int     @default(0)
  category  String
  label     String
  type      String
  options   String? // JSON 格式：存储选项配置（如 radio/checkbox 的选项列表，或 dynamic_list 的字段配置）
  isEnabled Boolean @default(true)
}

model DailyReport {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  area      String
  summary   String?
  answers   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([date])
  @@index([userId])
}

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model QuickLink {
  id        String   @id @default(cuid())
  title     String
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Issue {
  id             String   @id @default(cuid())
  title          String
  problemDesc    String
  problemImages  String?
  solutionDesc   String
  solutionImages String?
  userId         String
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id])
}

model Task {
  id          String    @id @default(cuid())
  content     String
  location    String
  deadline    DateTime?
  isCompleted Boolean   @default(false)
  order       Int       @default(0)
  userId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id])
  logs        TaskLog[]
  startTime   DateTime? @default(now()) 
  duration    Int?      @default(60)
}

model TaskLog {
  id           String   @id @default(cuid())
  taskId       String
  operatorId   String
  operatorName String
  action       String
  details      String?
  createdAt    DateTime @default(now())
  task         Task     @relation(fields: [taskId], references: [id])
}

model AISummary {
  id          String   @id @default(cuid())
  userId      String
  content     String   // AI生成的总结内容
  startDate   DateTime // 总结的开始日期
  endDate     DateTime // 总结的结束日期
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

model WeeklyReport {
  id              String    @id @default(cuid())
  userId          String
  title           String    // 周报标题，如 "8.17-8.23海铭德系统使用周报"
  startDate       DateTime  // 周期起始日期
  endDate         DateTime  // 周期截止日期
  weekNumber      Int?      // 年中第几周 (1-53)
  year            Int       // 年份，如 2026
  metrics         String    // JSON: 各模块解析与计算后的指标快照
  manualSections  String    // JSON: 手动填写的模块内容 (设备点检、保养、必应、培训、嘟嘟卡、改进建议等)
  activeModules   String?   // JSON: 本次启用的模块列表
  content         String    // 生成的标准纯文本周报内容
  markdownContent String?   // 企微富文本 Markdown 内容
  isPushedToWecom Boolean   @default(false)
  pushedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id])

  @@index([startDate, endDate])
  @@index([year, weekNumber])
  @@index([userId])
}
