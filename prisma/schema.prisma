generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")  // 你的 6543 端口链接
  directUrl = env("DIRECT_URL")   // 你的 5432 端口链接 (新增这一行)
}

model User {
  id                String        @id @default(cuid())
  workId            String        @unique
  name              String?
  password          String
  isDefaultPassword Boolean       @default(true)
  assignedAreas     String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  dailyReports      DailyReport[]
  issues            Issue[]
  tasks             Task[]
  roles             Role[]        @relation("RoleToUser")
}

model Role {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  users       User[]  @relation("RoleToUser")
}

model Question {
  id        String  @id @default(cuid())
  order     Int     @default(0)
  category  String
  label     String
  type      String
  isEnabled Boolean @default(true)
}

model DailyReport {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  area      String
  summary   String?
  answers   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([date])
  @@index([userId])
}

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model QuickLink {
  id        String   @id @default(cuid())
  title     String
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Issue {
  id             String   @id @default(cuid())
  title          String
  problemDesc    String
  problemImages  String?
  solutionDesc   String
  solutionImages String?
  userId         String
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id])
}

model Task {
  id          String    @id @default(cuid())
  content     String
  location    String
  deadline    DateTime?
  isCompleted Boolean   @default(false)
  order       Int       @default(0)
  userId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id])
  logs        TaskLog[]
  startTime   DateTime? @default(now()) 
  duration    Int?      @default(60)
}

model TaskLog {
  id           String   @id @default(cuid())
  taskId       String
  operatorId   String
  operatorName String
  action       String
  details      String?
  createdAt    DateTime @default(now())
  task         Task     @relation(fields: [taskId], references: [id])
}
