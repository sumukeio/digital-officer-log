generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. 用户表
model User {
  id                String        @id @default(cuid())
  workId            String        @unique
  name              String?
  password          String
  isDefaultPassword Boolean       @default(true)
  assignedAreas     String?       // "注塑A区,包装C区"
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  roles             Role[]        @relation("RoleToUser")
  dailyReports      DailyReport[]
  
  // ▼▼▼ 新增：关联问题表 (修复之前的 P1012 错误) ▼▼▼
  issues            Issue[]
  tasks             Task[]
}

// 2. 角色表
model Role {
  id    String @id @default(cuid())
  name  String @unique // "admin", "officer"
  description String?
  users User[] @relation("RoleToUser")
}

// 3. 题目模板表
model Question {
  id        String  @id @default(cuid())
  order     Int     @default(0)
  category  String  // "一、生产与质量"
  label     String
  type      String  // "number", "boolean", "text"
  isEnabled Boolean @default(true)
}

// 4. 日报记录表
model DailyReport {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  date      DateTime // 记录日期 (即使是补填也是那天的日期)
  area      String   // "注塑A区"
  summary   String?  // 文字总结
  answers   String   // JSON String: { "qId": { value: 1, remark: "xx", images: [] } }
  createdAt DateTime @default(now()) // 实际提交时间

  @@index([date])
  @@index([userId])
}

// 5. 系统配置表 (Logo, Name)
model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique // "app_logo", "app_name"
  value     String   // URL 或 文本
  updatedAt DateTime @updatedAt
}

// 6. 快捷访问链接 (Quick Access)
model QuickLink {
  id        String   @id @default(cuid())
  title     String
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// 7. 问题与解决方案 (Knowledge Base)
model Issue {
  id             String   @id @default(cuid())
  title          String
  problemDesc    String
  problemImages  String?  // JSON string: ["url1", "url2"]
  
  solutionDesc   String
  solutionImages String?  // JSON string: ["url1", "url2"]
  
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  
  createdAt      DateTime @default(now())
}

// 8. 任务看板 (Task Kanban)
model Task {
  id          String   @id @default(cuid())
  content     String   // 任务内容
  location    String   // 执行地点
  deadline    DateTime // 截止时间
  isCompleted Boolean  @default(false) // 是否结束
  order       Int      @default(0)     // 排序权重
  
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  logs        TaskLog[]
}

// 9. 任务日志 (Audit Log)
model TaskLog {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id])
  
  operatorId String   // 操作人ID (可能是自己，也可能是管理员)
  operatorName String // 冗余存一个名字方便查
  
  action     String   // "CREATE", "UPDATE", "COMPLETE", "MOVE"
  details    String?  // 详情: "从 A区 移动到 B区"
  
  createdAt  DateTime @default(now())
}